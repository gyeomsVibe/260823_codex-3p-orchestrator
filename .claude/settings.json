{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/swarm_hook.py",
              "brief"
            ],
            "timeout": 15,
            "statusMessage": "스웜 상태 브리핑",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/swarm_hook.py",
              "notify"
            ],
            "timeout": 15,
            "statusMessage": "새 스웜 메시지 확인"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/swarm_hook.py",
              "guard-write"
            ],
            "timeout": 15,
            "statusMessage": "채널 소유권 확인"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/swarm_hook.py",
              "guard-bash"
            ],
            "timeout": 15,
            "statusMessage": "PRE-PUSH 게이트 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/swarm_hook.py",
              "evidence"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/swarm_hook.py",
              "channel-watch"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
